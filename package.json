{
  "name": "agentsdir",
  "version": "1.0.0",
  "description": "CLI that installs an agent configuration architecture based on open standards (AGENTS.md, Agent Skills) into an existing repo.",
  "keywords": [
    "agents",
    "agents-md",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "ai-agents",
    "cli",
    "scaffolding",
    "developer-tools"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Raphaël Picard",
  "homepage": "https://github.com/PicardRaphael/agentsdir#readme",
  "bugs": {
    "url": "https://github.com/PicardRaphael/agentsdir/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PicardRaphael/agentsdir.git"
  },
  "bin": {
    "agentsdir": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
